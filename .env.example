VIDEO_DIR=./videos
HTTP_PORT=8080
# За reverse proxy укажите адрес, доступный телевизору; для IP:port оставьте пустым.
PUBLIC_URL=
ADMIN_USER=admin
# Задайте свой пароль (не менее 12 символов). Не добавляйте .env в Git.
ADMIN_PASSWORD=
OUTPUT_FPS=30
CRF=20
FFMPEG_THREADS=2
PREPARE_JOBS=1
# Максимальный размер одного загружаемого файла: 2 GiB.
MAX_UPLOAD_BYTES=2147483648
